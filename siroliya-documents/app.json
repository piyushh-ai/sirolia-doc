{
  "expo": {
    "name": "SiroVault",
    "slug": "siroliya-documents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/siroVault-icon.png",
    "scheme": "siroliyadocuments",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/siroVault-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.piyushsiroliya.siroliyadocuments"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B1A",
          "image": "./assets/images/sirovault-splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "cover"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "add5a3f4-f668-4b75-a34a-886835cbf979"
      }
    }
  }
}
